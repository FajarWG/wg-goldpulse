# WG GoldPulse configuration
# Copy to .env and fill in only what you need. Everything here is optional:
# with no .env at all the tool runs using Yahoo Finance and skips LLM/Telegram.

# ---------------------------------------------------------------------------
# What to analyse
# ---------------------------------------------------------------------------
# Comma-separated pairs. Accepts EURUSD, eur/usd, EUR-USD, EURUSD=X.
# Metals: XAUUSD, XAGUSD, XPTUSD, XPDUSD.
FOREX_SYMBOLS=XAUUSD

# Subset of H1,H4,D1
# FOREX_TIMEFRAMES=H1,H4,D1

# Candles requested per timeframe
# FOREX_BARS=300

# ---------------------------------------------------------------------------
# Data providers (tried in order; unset providers are skipped)
# ---------------------------------------------------------------------------
# Twelve Data - native 4h candles, free tier available
# https://twelvedata.com/pricing
# TWELVEDATA_API_KEY=
# TWELVEDATA_API_KEY2=
# TWELVEDATA_DAILY_LIMIT=800
# TWELVEDATA_USAGE_DB=state/usage.sqlite3
# Backfill only: throttle/retry to stay below per-minute limits.
# TWELVEDATA_MIN_REQUEST_INTERVAL_SECONDS=0
# TWELVEDATA_RETRY_ROUNDS=1

# Alpha Vantage - FX only (no metals), rate-limited free tier
# https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Yahoo Finance needs no key and is the default fallback.
# Force one provider: twelvedata | alphavantage | yfinance
# FOREX_PROVIDER=

# ---------------------------------------------------------------------------
# LLM commentary (optional; any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# AI is NEVER generated automatically. It is only produced on demand via:
#   - python main.py --ai
#   - desktop app: "AI Analisis" button
#   - Telegram: /ai command or the 🤖 Analisis AI button
# Without a key the report is still produced from computed analysis alone.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1600

# Alternatives - only LLM_BASE_URL and LLM_MODEL change:
#   OpenRouter  https://openrouter.ai/api/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Groq        https://api.groq.com/openai/v1
#   local vLLM  http://localhost:8000/v1
# OPENAI_API_KEY, OPENROUTER_API_KEY, DEEPSEEK_API_KEY and GROQ_API_KEY
# are also accepted, so you need not rename an existing key.

# ---------------------------------------------------------------------------
# Telegram push (optional; both values required)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Ordered AI explanation fallback. AI never changes the deterministic signal.
# AI_PROVIDER_ORDER=groq,gemini,deepseek
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Telegram (optional; both values required)
# ---------------------------------------------------------------------------
# Bot yang sama dipakai untuk push notifikasi dan untuk meminta analisis AI
# secara manual (ketik /ai atau tekan tombol 🤖 Analisis AI). AI dijelaskan dari
# payload analisis terakhir yang ditulis ke FOREX_STATE_PATH (state/latest.json).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# WG GoldPulse signal, tracking, and backtest
# ---------------------------------------------------------------------------
# FOREX_STATE_DIR=state
# FOREX_STATE_PATH=state/latest.json
# SIGNAL_TRACKING_DB=state/signals.sqlite3
# SIGNAL_STRATEGY_VERSION=v6
# SIGNAL_MAX_FULL_PER_DAY=5
# SIGNAL_MAX_MOMENTUM_PER_DAY=5
# SIGNAL_MAX_ACTIVE_MOMENTUM=3
# SIGNAL_COOLDOWN_MINUTES=30
# SIGNAL_TIMEOUT_MINUTES=240
# BACKTEST_LOOKBACK_DAYS=90
# BOT_DISPLAY_NAME=WG GoldPulse

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# FOREX_OUTPUT_DIR=reports
# FOREX_REPORT_FORMAT=markdown
# LOG_LEVEL=INFO
