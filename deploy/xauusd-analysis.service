[Unit]
Description=XAUUSD multi-timeframe analysis report
Documentation=https://github.com/FajarWG/wg-goldpulse
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/xauusd-analysis
EnvironmentFile=/etc/xauusd-analysis.env
ExecStart=/opt/xauusd-analysis/.venv/bin/python /opt/xauusd-analysis/main.py --symbols XAUUSD --timeframes H1,H4,D1 --output-dir /var/lib/xauusd-analysis/reports --stdout
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xauusd-analysis

[Install]
WantedBy=multi-user.target
