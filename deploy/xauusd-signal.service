[Unit]
Description=XAUUSD M5/M15 SMC confirmation (analysis only)
Documentation=https://github.com/FajarWG/wg-goldpulse
Wants=network-online.target
After=network-online.target xauusd-analysis.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/xauusd-analysis
EnvironmentFile=/etc/xauusd-analysis.env
ExecStart=/opt/xauusd-analysis/.venv/bin/python /opt/xauusd-analysis/signal_main.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xauusd-analysis

[Install]
WantedBy=multi-user.target
