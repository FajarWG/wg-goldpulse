#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  exec sudo -- "$0" "$@"
fi

env_file=/etc/xauusd-analysis.env
tmp_file=$(mktemp /etc/xauusd-analysis.env.XXXXXX)
backup_file=$(mktemp /etc/xauusd-analysis.env.backup.XXXXXX)
trap 'rm -f "$tmp_file" "$backup_file"' EXIT
install -o root -g root -m 0600 "$env_file" "$tmp_file"
install -o root -g root -m 0600 "$env_file" "$backup_file"

printf '%s\n' 'Kosongkan input untuk mempertahankan nilai lama. Masukkan satu tanda - untuk menghapus nilai.'
read -r -s -p 'Twelve Data API key: ' twelvedata_key
printf '\n'
read -r -s -p 'Telegram bot token BARU: ' telegram_token
printf '\n'
read -r -p 'Telegram chat ID: ' telegram_chat_id

if [[ -n "$twelvedata_key" && "$twelvedata_key" != '-' && ! "$twelvedata_key" =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo 'Format Twelve Data API key tidak valid.' >&2
  exit 2
fi
if [[ -n "$telegram_token" && "$telegram_token" != '-' && ! "$telegram_token" =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]]; then
  echo 'Format Telegram bot token tidak valid.' >&2
  exit 2
fi
if [[ -n "$telegram_chat_id" && "$telegram_chat_id" != '-' && ! "$telegram_chat_id" =~ ^-?[0-9]+$ ]]; then
  echo 'Telegram chat ID harus berupa angka.' >&2
  exit 2
fi

update_value() {
  local name=$1
  local value=$2
  [[ -z "$value" ]] && return 0
  sed -i "/^${name}=/d" "$tmp_file"
  [[ "$value" == '-' ]] && return 0
  printf '%s=%s\n' "$name" "$value" >> "$tmp_file"
}

update_value TWELVEDATA_API_KEY "$twelvedata_key"
update_value TELEGRAM_BOT_TOKEN "$telegram_token"
update_value TELEGRAM_CHAT_ID "$telegram_chat_id"
install -o root -g root -m 0600 "$tmp_file" "$env_file"
unset twelvedata_key telegram_token telegram_chat_id

if ! /opt/xauusd-analysis/.venv/bin/python - <<'PY'
from pathlib import Path
import sys
import requests

values = {}
for line in Path('/etc/xauusd-analysis.env').read_text(encoding='utf-8').splitlines():
    if '=' in line and not line.lstrip().startswith('#'):
        key, value = line.split('=', 1)
        values[key] = value.strip()

token = values.get('TELEGRAM_BOT_TOKEN', '')
chat_id = values.get('TELEGRAM_CHAT_ID', '')
if token or chat_id:
    if not token or not chat_id:
        print('Token dan chat ID Telegram harus dikonfigurasi bersama.', file=sys.stderr)
        raise SystemExit(1)
    try:
        response = requests.get(f'https://api.telegram.org/bot{token}/getMe', timeout=15)
        if not response.ok or not response.json().get('ok'):
            print(f'Token Telegram ditolak (HTTP {response.status_code}).', file=sys.stderr)
            raise SystemExit(1)
        response = requests.post(
            f'https://api.telegram.org/bot{token}/sendMessage',
            json={
                'chat_id': chat_id,
                'text': '✅ XAUUSD analysis bot terhubung. Konfigurasi Telegram berhasil.',
            },
            timeout=15,
        )
        if not response.ok or not response.json().get('ok'):
            print(f'Chat ID Telegram ditolak (HTTP {response.status_code}).', file=sys.stderr)
            raise SystemExit(1)
    except requests.RequestException as exc:
        # Exception text can contain the request URL and therefore the bot token.
        print(f'Validasi Telegram gagal ({type(exc).__name__}).', file=sys.stderr)
        raise SystemExit(1)
PY
then
  install -o root -g root -m 0600 "$backup_file" "$env_file"
  echo 'Konfigurasi lama dipulihkan karena validasi gagal.' >&2
  exit 1
fi

systemctl reset-failed xauusd-analysis.service || true
if systemctl start xauusd-analysis.service; then
  echo 'Konfigurasi tersimpan dan analisis berhasil.'
else
  echo 'Konfigurasi tersimpan, tetapi analisis gagal. Log terakhir:' >&2
  journalctl -u xauusd-analysis.service -n 25 --no-pager -o cat >&2
  exit 1
fi
