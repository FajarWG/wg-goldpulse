FOREX_SYMBOLS=XAUUSD
FOREX_TIMEFRAMES=H1,H4,D1
TWELVEDATA_API_KEY=
TWELVEDATA_API_KEY2=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# AI keys stay available for on-demand requests (/ai or Telegram button).
# The hourly systemd run does NOT pass --ai, so no LLM call happens there.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
FOREX_OUTPUT_DIR=/var/lib/xauusd-analysis/reports
FOREX_REPORT_FORMAT=markdown
LOG_LEVEL=INFO
PYTHONUTF8=1
PYTHONDONTWRITEBYTECODE=1
XDG_CACHE_HOME=/var/lib/xauusd-analysis/cache
TWELVEDATA_USAGE_DB=/var/lib/xauusd-analysis/usage.sqlite3
TWELVEDATA_DAILY_LIMIT=800
TWELVEDATA_MIN_REQUEST_INTERVAL_SECONDS=0
TWELVEDATA_RETRY_ROUNDS=1
FOREX_STATE_DIR=/var/lib/xauusd-analysis
FOREX_STATE_PATH=/var/lib/xauusd-analysis/latest.json
SIGNAL_MAX_FULL_PER_DAY=5
SIGNAL_MAX_MOMENTUM_PER_DAY=5
SIGNAL_COOLDOWN_MINUTES=30
SIGNAL_TRACKING_DB=/var/lib/xauusd-analysis/signals.sqlite3
SIGNAL_STRATEGY_VERSION=v6
SIGNAL_TIMEOUT_MINUTES=240
BOT_DISPLAY_NAME=WG GoldPulse
AI_PROVIDER_ORDER=groq,gemini,deepseek
BACKTEST_LOOKBACK_DAYS=90
